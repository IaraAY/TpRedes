@{
    ViewData["Title"] = "Red";
}

<div class="contenedor-principal">
    <div class="tarjeta-formulario">
        <h2 class="titulo-pantalla">¡Bienvenido, @ViewBag.Usuario.NombreUsuario!</h2>
        <a href="@Url.Action("CrearPublicacion", "Home")" class="btn btn-primary">Crear Publicación</a>
        <a href="@Url.Action("CerrarSesion", "Home")" class="btn btn-secondary">Cerrar Sesión</a>
    </div>
</div>

<div id="feedPublicaciones" class="mt-4"></div>
<button id="btnVerMas" type="button" class="btn btn-outline-primary mt-3" style="display:none;">Ver más</button>

<script>
    let offset = 0;
    const limit = 10;
    let hayMas = true;

    const feed = document.getElementById('feedPublicaciones');
    const btnVerMas = document.getElementById('btnVerMas');

    function formatearFecha(fecha) {
        if (!fecha) return '';
        const d = new Date(fecha);
        return d.toLocaleString('es-AR', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    function renderComentarios(comentarios) {
        if (!comentarios || comentarios.length === 0) {
            return '<div class="text-muted">Sin comentarios todavía.</div>';
        }

        return comentarios.map(c => `
            <div class="comentario-item">
                <strong>${c.nombreUsuario}</strong>
                <div>${c.texto}</div>
                <small>${formatearFecha(c.fechaComentario)}</small>
            </div>
        `).join('');
    }

    function renderPublicaciones(publicaciones) {
        if (!publicaciones || publicaciones.length === 0) {
            if (offset === 0) {
                feed.innerHTML = '<div class="alert alert-info">No hay publicaciones.</div>';
            }
            btnVerMas.style.display = 'none';
            hayMas = false;
            return;
        }

        publicaciones.forEach(pub => {
            const card = document.createElement('article');
            card.className = 'card mb-4';
            card.innerHTML = `
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">${pub.titulo || ''}</h4>
                        <button class="btn btn-sm ${pub.meGusta ? 'btn-danger' : 'btn-outline-danger'} like-btn" data-id="${pub.id}">
                            ${pub.meGusta ? 'Quitar me gusta' : 'Me gusta'} (<span class="like-count">${pub.cantidadLikes || 0}</span>)
                        </button>
                    </div>

                    <div class="text-muted mb-2">
                        <strong>${pub.nombreUsuario || 'Usuario'}</strong> · ${formatearFecha(pub.fechaPublicacion)}
                    </div>

                    ${pub.imagen ? `<img src="/images/${pub.imagen}" alt="${pub.titulo}" class="img-fluid rounded mb-3" style="max-height:300px; object-fit:cover; width:100%;" />` : ''}

                    <p>${pub.descripcion || ''}</p>

                    <div class="comentarios-box mb-3">
                        ${renderComentarios(pub.comentarios)}
                    </div>

                    <div class="comentario-form">
                        <textarea class="form-control mb-2 comentario-texto" data-id="${pub.id}" rows="2" placeholder="Escribí un comentario..."></textarea>
                        <button class="btn btn-primary btn-sm comentar-btn" data-id="${pub.id}">Comentar</button>
                    </div>
                </div>
            `;
            feed.appendChild(card);
        });

        bindLikeButtons();
        bindComentarioButtons();
    }

    function bindLikeButtons() {
        document.querySelectorAll('.like-btn').forEach(button => {
            button.addEventListener('click', async function () {
                const idPublicacion = Number(this.dataset.id);
                const response = await fetch('/Home/ToggleLike', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idPublicacion })
                });

                const data = await response.json();
                if (!data.ok) {
                    alert(data.error || 'No se pudo actualizar el like');
                    return;
                }

                const target = this.querySelector('.like-count');
                const count = Number(target.textContent || 0);
                const isLiked = data.meGusta;

                target.textContent = data.cantidadLikes;
                this.classList.toggle('btn-danger', isLiked);
                this.classList.toggle('btn-outline-danger', !isLiked);
                this.textContent = (isLiked ? 'Quitar me gusta' : 'Me gusta') + ' (';
                this.innerHTML = `${isLiked ? 'Quitar me gusta' : 'Me gusta'} (<span class="like-count">${data.cantidadLikes}</span>)`;
            });
        });
    }

    function bindComentarioButtons() {
        document.querySelectorAll('.comentar-btn').forEach(button => {
            button.addEventListener('click', async function () {
                const idPublicacion = Number(this.dataset.id);
                const textarea = document.querySelector(`.comentario-texto[data-id="${idPublicacion}"]`);
                const texto = textarea.value.trim();

                if (!texto) {
                    alert('El comentario no puede estar vacío');
                    return;
                }

                const response = await fetch('/Home/AgregarComentario', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idPublicacion, texto })
                });

                const data = await response.json();
                if (!data.ok) {
                    alert(data.error || 'No se pudo guardar el comentario');
                    return;
                }

                const comentario = data.comentario;
                const card = this.closest('article');
                const contenedor = card.querySelector('.comentarios-box');
                const actual = contenedor.innerHTML;
                const nuevo = `
                    <div class="comentario-item">
                        <strong>${comentario.nombreUsuario}</strong>
                        <div>${comentario.texto}</div>
                        <small>${formatearFecha(comentario.fechaComentario)}</small>
                    </div>
                `;

                if (actual.includes('Sin comentarios todavía.')) {
                    contenedor.innerHTML = nuevo;
                } else {
                    contenedor.innerHTML = actual + nuevo;
                }

                textarea.value = '';
            });
        });
    }

    async function cargarPublicaciones() {
        const response = await fetch(`/Home/GetPublicaciones?offset=${offset}&limit=${limit}`);
        const data = await response.json();

        if (!data.ok) {
            alert(data.error || 'Error al cargar publicaciones');
            return;
        }

        if (data.publicaciones.length < limit) {
            hayMas = false;
        }

        renderPublicaciones(data.publicaciones);
        btnVerMas.style.display = hayMas ? 'block' : 'none';
    }

    btnVerMas.addEventListener('click', async () => {
        if (!hayMas) return;
        offset += limit;
        const response = await fetch(`/Home/GetPublicaciones?offset=${offset}&limit=${limit}`);
        const data = await response.json();

        if (!data.ok) {
            alert(data.error || 'Error al cargar más publicaciones');
            return;
        }

        if (data.publicaciones.length < limit) {
            hayMas = false;
        }

        renderPublicaciones(data.publicaciones);
        btnVerMas.style.display = hayMas ? 'block' : 'none';
    });

    cargarPublicaciones();
</script>